{
  "name": "swing-stocks",
  "version": "0.41.0",
  "private": true,
  "type": "module",
  "description": "Swing Terminal \u2014 cloud-backed multi-strategy swing-trading console. GitHub Pages SPA + Firebase Auth/Firestore.",
  "homepage": "https://goofyclub.github.io/swing-stocks/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:engine": "node tests/engine-parity.mjs",
    "test:settle": "node tests/settle.mjs",
    "test:auto": "node tests/auto.mjs",
    "test:condor": "node tests/condor.mjs",
    "test": "node tests/engine-parity.mjs && node tests/settle.mjs && node tests/auto.mjs && node tests/condor.mjs && node tests/perf.mjs && node tests/maintenance.mjs",
    "refresh:signals": "node scripts/refresh-signals.mjs",
    "refresh:universe": "node scripts/refresh-universe.mjs",
    "auto:trade": "node scripts/auto-trade.mjs",
    "backtest:stop": "node scripts/backtest-stop.mjs",
    "auto:sameday": "node scripts/same-day-trade.mjs",
    "auto:smoketest": "node scripts/alpaca-smoketest.mjs",
    "bot": "node scripts/telegram-bot.mjs",
    "dashboard": "node scripts/dashboard.mjs",
    "deploy": "bash scripts/deploy.sh",
    "config:example": "node scripts/print-env-example.mjs > config/swing.env.example",
    "config": "node scripts/config-set.mjs",
    "setup": "bash scripts/setup-vm.sh",
    "test:perf": "node tests/perf.mjs",
    "test:maintenance": "node tests/maintenance.mjs",
    "auto:maintenance": "node scripts/maintenance.mjs",
    "dashboard:cert": "bash scripts/make-dashboard-cert.sh"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "firebase": "^10.12.0"
  },
  "devDependencies": {
    "firebase-admin": "^12.1.0",
    "vite": "^5.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
