# swing-stocks runtime configuration
# Generated from src/config/env.js — the single source of truth.
# Regenerate:  node scripts/print-env-example.mjs > config/swing.env.example

# ==========================================================================
# Firebase — required
# ==========================================================================
# Firebase/Firestore project id that holds signals and user config.
FIREBASE_PROJECT_ID=

# Path to a service-account key JSON. Preferred over pasting the key inline.
# Leave empty on GCE to use the VM's attached service account (Application
# Default Credentials).
# FIREBASE_SERVICE_ACCOUNT_FILE=

# Raw service-account key JSON. Used by CI (GitHub Secrets). On a VM prefer
# the _FILE form or ADC — systemd EnvironmentFile mishandles the quotes in
# this blob.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ==========================================================================
# Market data — ALPACA_* strongly recommended
# ==========================================================================
# Alpaca market-data key. Paper keys work. Strongly recommended: without it
# bar fetching falls back to keyless endpoints that rate-limit on a
# full-universe scan.
# ALPACA_KEY=

# Alpaca market-data secret. NOTE: market data only — the keys used to PLACE
# orders come from each user's Firestore automation config, not here.
# ALPACA_SECRET=

# Optional fallback data source.
# ALPHAVANTAGE_KEY=

# Optional fallback data source.
# FINNHUB_KEY=

# Optional. Enables the PEAD / Insider / Analyst strategies, which need
# fundamentals.
# FMP_KEY=

# ==========================================================================
# Execution behaviour
# ==========================================================================
# TRUE logs intended orders without submitting. Defaults true everywhere —
# flip to false only after reviewing a dry-run log.
DRY_RUN=true

# Hard gate for REAL-MONEY orders. A live broker URL alone can never trade
# real money without this.
ALLOW_LIVE=false

# Abort the run immediately, placing nothing. Per-run; the persistent switch
# is Firestore publicConfig/automation.paused (Telegram /pause).
KILL_SWITCH=false

# Restrict a run to one user id. Testing only.
# ONLY_UID=

# Same-day runner only: bypass the 15:35-15:50 ET close-window check so it
# can be tested at any hour.
FORCE_WINDOW=false

# Universe to scan. core = 51 curated names (~15s). broad = full S&P
# universe, 1503 names (~6-7 min). Use broad to match what refresh-signals
# scans.
# one of: core | broad
WATCHLIST_SET=core

# Comma list restricting which strategies run. Empty = every strategy the
# user has enabled.
# STRATEGIES=

# Markets the refresh cron scans.
MARKETS=US,INDIA

# ==========================================================================
# Telegram control bot
# ==========================================================================
# Bot token from @BotFather. Required to run the control bot.
# TELEGRAM_BOT_TOKEN=

# SECURITY-CRITICAL allow-list of chat ids permitted to issue commands. The
# bot refuses to start when empty — an open control bot lets anyone who
# finds it flatten your positions.
# TELEGRAM_ALLOWED_CHAT_IDS=

# Firestore user id the bot reports on and controls. Defaults to the single
# automation-enabled user when exactly one exists.
# TELEGRAM_ADMIN_UID=

# Telegram long-poll timeout. 25s keeps the connection cheap and responsive.
BOT_POLL_SECONDS=25

# Absolute path to the checkout, used by /deploy. Empty disables /deploy.
# REPO_DIR=

# ==========================================================================
# Log dashboard (scripts/dashboard.mjs)
# ==========================================================================
# Basic-auth username. Required to run the dashboard — it serves the trading
# log, so it refuses to start unauthenticated.
# DASHBOARD_USER=

# sha256 hex digest of the password. Generate with: read -rs PW && printf
# '%s' "$PW" | sha256sum && unset PW
# DASHBOARD_PASSWORD_HASH=

# Listen port. Cannot be shared with another dashboard — one port, one
# process. ORB uses 8443.
DASHBOARD_PORT=8444

# Bind address. Set 127.0.0.1 to force access through an SSH tunnel
# (recommended — this is plain HTTP).
DASHBOARD_BIND=0.0.0.0

# Auto-refresh interval for the log pane.
DASHBOARD_REFRESH_SEC=20

# Override the shared log path. Default: <repo>/logs/swing.log — every
# runner, the bot and deploys append to it.
# SWING_LOG_FILE=
